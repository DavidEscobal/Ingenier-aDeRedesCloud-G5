{
  "openapi": "3.1.0",
  "info": {
    "title": "G5 Slice Manager",
    "description": "Intención y autorización de slices; delega la ejecución en el platform-manager.",
    "version": "0.3.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/slices": {
      "post": {
        "tags": [
          "slices"
        ],
        "summary": "Create Slice",
        "operationId": "create_slice_v1_slices_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SliceCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "slices"
        ],
        "summary": "List Slices",
        "operationId": "list_slices_v1_slices_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SliceView"
                  },
                  "title": "Response List Slices V1 Slices Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/slices/{slice_id}": {
      "get": {
        "tags": [
          "slices"
        ],
        "summary": "Get Slice",
        "operationId": "get_slice_v1_slices__slice_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "slice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Slice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SliceDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "slices"
        ],
        "summary": "Delete Slice",
        "operationId": "delete_slice_v1_slices__slice_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "slice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Slice Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/slices/{slice_id}/vms/{vm}/console": {
      "post": {
        "tags": [
          "slices"
        ],
        "summary": "Vm Console",
        "description": "URL de consola (noVNC con token de Nova, de vida corta). Solo dueño o admin, como el resto del slice.",
        "operationId": "vm_console_v1_slices__slice_id__vms__vm__console_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "slice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Slice Id"
            }
          },
          {
            "name": "vm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$",
              "title": "Vm"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Console"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "slice_id": {
            "type": "string",
            "title": "Slice Id"
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "slice_id",
          "operation_id",
          "status"
        ],
        "title": "Accepted"
      },
      "Capabilities": {
        "properties": {
          "service": {
            "type": "string",
            "const": "slice-manager",
            "title": "Service",
            "default": "slice-manager"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "phase": {
            "type": "string",
            "const": "bootstrap",
            "title": "Phase",
            "default": "bootstrap"
          },
          "features": {
            "$ref": "#/components/schemas/Features"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "features"
        ],
        "title": "Capabilities"
      },
      "Console": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "vm": {
            "type": "string",
            "title": "Vm"
          }
        },
        "type": "object",
        "required": [
          "url",
          "provider",
          "vm"
        ],
        "title": "Console"
      },
      "Features": {
        "properties": {
          "slice_lifecycle": {
            "type": "boolean",
            "title": "Slice Lifecycle",
            "default": false
          },
          "persistence": {
            "type": "boolean",
            "title": "Persistence",
            "default": false
          },
          "iam": {
            "type": "boolean",
            "title": "Iam",
            "default": true
          },
          "queue": {
            "type": "boolean",
            "title": "Queue",
            "default": false
          },
          "linux_r2": {
            "type": "boolean",
            "title": "Linux R2",
            "default": false
          },
          "openstack": {
            "type": "boolean",
            "title": "Openstack",
            "default": false
          },
          "placement": {
            "type": "boolean",
            "title": "Placement",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Features"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "const": "slice-manager",
            "title": "Service",
            "default": "slice-manager"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "SliceCreate": {
        "properties": {
          "course_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Course Id"
          },
          "spec": {
            "additionalProperties": true,
            "type": "object",
            "title": "Spec",
            "description": "Especificación del slice (formato del platform-manager)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "course_id",
          "spec"
        ],
        "title": "SliceCreate"
      },
      "SliceDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "vms": {
            "items": {
              "$ref": "#/components/schemas/VmView"
            },
            "type": "array",
            "title": "Vms",
            "default": []
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/SliceEvent"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "status",
          "course_id",
          "owner_id",
          "owner",
          "created_at",
          "events"
        ],
        "title": "SliceDetail"
      },
      "SliceEvent": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "seq"
        ],
        "title": "SliceEvent"
      },
      "SliceView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "status",
          "course_id",
          "owner_id",
          "owner",
          "created_at"
        ],
        "title": "SliceView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VmView": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "vcpus": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vcpus"
          },
          "memory_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Mb"
          },
          "disk_gb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disk Gb"
          },
          "networks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Networks",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "VmView"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
