{
  "openapi": "3.1.0",
  "info": {
    "title": "G5 Slice Manager",
    "description": "Base de comunicación. Aún no admite ni ejecuta operaciones de slices.",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "service": {
            "type": "string",
            "const": "slice-manager",
            "title": "Service",
            "default": "slice-manager"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "phase": {
            "type": "string",
            "const": "bootstrap",
            "title": "Phase",
            "default": "bootstrap"
          },
          "features": {
            "$ref": "#/components/schemas/Features"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "features"
        ],
        "title": "Capabilities"
      },
      "Features": {
        "properties": {
          "slice_lifecycle": {
            "type": "boolean",
            "title": "Slice Lifecycle",
            "default": false
          },
          "persistence": {
            "type": "boolean",
            "title": "Persistence",
            "default": false
          },
          "iam": {
            "type": "boolean",
            "title": "Iam",
            "default": true
          },
          "queue": {
            "type": "boolean",
            "title": "Queue",
            "default": false
          },
          "linux_r2": {
            "type": "boolean",
            "title": "Linux R2",
            "default": false
          },
          "openstack": {
            "type": "boolean",
            "title": "Openstack",
            "default": false
          },
          "placement": {
            "type": "boolean",
            "title": "Placement",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Features"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "const": "slice-manager",
            "title": "Service",
            "default": "slice-manager"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
