              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/topologies/validate": {
      "post": {
        "tags": [
          "topologies"
        ],
        "summary": "Validate Topology",
        "description": "Para importar: el esquema ya se validó al leer el cuerpo; aquí se revisa además el catálogo.",
        "operationId": "validate_topology_v1_topologies_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/topologies/compile": {
      "post": {
        "tags": [
          "topologies"
        ],
        "summary": "Compile Topology",
        "operationId": "compile_topology_v1_topologies_compile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
