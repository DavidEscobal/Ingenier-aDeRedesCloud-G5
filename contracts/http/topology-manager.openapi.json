                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/drafts": {
      "get": {
        "tags": [
          "drafts"
        ],
        "summary": "List Drafts",
        "operationId": "list_drafts_v1_drafts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DraftSummary"
                  },
                  "type": "array",
                  "title": "Response List Drafts V1 Drafts Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "drafts"
        ],
        "summary": "Create Draft",
        "operationId": "create_draft_v1_drafts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/drafts/{draft_id}": {
      "get": {
        "tags": [
          "drafts"
        ],
        "summary": "Get Draft",
        "operationId": "get_draft_v1_drafts__draft_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Draft Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "drafts"
        ],
        "summary": "Update Draft",
        "operationId": "update_draft_v1_drafts__draft_id__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Draft Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "drafts"
        ],
        "summary": "Delete Draft",
        "operationId": "delete_draft_v1_drafts__draft_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Draft Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CombineRequest": {
        "properties": {
          "base": {
            "$ref": "#/components/schemas/Topology"
          },
          "add": {
            "$ref": "#/components/schemas/Topology"
          },
          "connect": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Connect",
            "description": "(nodo de base, nodo de add) a enlazar"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base",
          "add"
        ],
        "title": "CombineRequest"
      },
      "CompileRequest": {
        "properties": {
          "topology": {
            "$ref": "#/components/schemas/Topology"
          },
          "provider": {
            "type": "string",
            "enum": [
              "openstack",
              "linux"
            ],
            "title": "Provider",
            "default": "openstack"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topology"
        ],
        "title": "CompileRequest"
      },
      "Draft": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "nodes": {
            "type": "integer",
            "title": "Nodes"
          },
          "segments": {
            "type": "integer",
            "title": "Segments"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "topology": {
            "$ref": "#/components/schemas/Topology"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "nodes",
          "segments",
          "updated_at",
          "topology"
        ],
        "title": "Draft"
      },
      "DraftSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "nodes": {
            "type": "integer",
            "title": "Nodes"
          },
          "segments": {
            "type": "integer",
            "title": "Segments"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "nodes",
          "segments",
          "updated_at"
        ],
        "title": "DraftSummary"
      },
      "DraftUpdate": {
        "properties": {
          "topology": {
            "$ref": "#/components/schemas/Topology"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topology",
          "version"
        ],
        "title": "DraftUpdate"
      },
      "DraftWrite": {
        "properties": {
          "topology": {
            "$ref": "#/components/schemas/Topology"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topology"
        ],
        "title": "DraftWrite"
      },
      "GenerateRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 32,
            "title": "Kind"
          },
          "n": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "N"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "prefix": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{0,8}$",
            "title": "Prefix",
            "default": "n"
          },
          "image": {
            "type": "string",
            "title": "Image",
            "default": "cirros"
          },
          "size": {
            "type": "string",
            "title": "Size",
            "default": "small"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "n"
        ],
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "const": "topology-manager",
            "title": "Service",
            "default": "topology-manager"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "Node": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Id"
          },
          "image": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Image"
          },
          "vcpus": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Vcpus"
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 524288.0,
            "minimum": 64.0,
            "title": "Memory Mb"
          },
          "disk_gb": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Disk Gb"
          },
          "internet": {
            "type": "boolean",
            "title": "Internet",
            "default": false
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "image",
          "vcpus",
          "memory_mb",
          "disk_gb"
        ],
        "title": "Node"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": -100000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": -100000.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Position"
      },
      "Segment": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "link",
              "bus"
            ],
            "title": "Kind"
          },
          "members": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 2,
            "title": "Members"
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "members"
        ],
        "title": "Segment"
      },
      "Topology": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "title": "Description",
            "default": ""
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Nodes"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 48,
            "title": "Segments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "nodes"
        ],
        "title": "Topology"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
