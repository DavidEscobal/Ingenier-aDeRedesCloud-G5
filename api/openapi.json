      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Network": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "cidr": {
            "type": "string",
            "example": "192.168.50.0/24"
          },
          "cvid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          },
          "dhcp": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "cidr",
          "cvid"
        ],
        "additionalProperties": false
      },
      "NIC": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "ip": {
            "type": "string",
            "format": "ipv4"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,14}$",
            "description": "Nombre estable dentro del invitado; cloud-init Ubuntu o configuración serie CirrOS."
          }
        },
        "required": [
          "network",
          "ip"
        ],
        "additionalProperties": false
      },
      "VM": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "worker": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "image": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vcpus": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "memory_mb": {
            "type": "integer",
            "minimum": 128,
            "maximum": 524288
          },
          "disk_gb": {
            "type": "number",
            "minimum": 1,
            "maximum": 2048,
            "description": "Admite 2.2. Unidad seleccionada por disk_unit en cluster.json (GiB por defecto; GB decimal disponible). Plan convierte a bytes y alinea a 512 bytes sin reducir la imagen base."
          },
          "nics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NIC"
            },
            "minItems": 1,
            "maxItems": 8
          },
          "internet": {
            "type": "boolean",
            "default": false
          },
          "guest": {
            "$ref": "#/components/schemas/Guest"
          }
        },
        "required": [
          "name",
          "worker",
          "image",
          "vcpus",
          "memory_mb",
          "disk_gb",
          "nics"
        ],
        "additionalProperties": false
      },
      "Publication": {
        "type": "object",
        "properties": {
          "vm": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "network": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "external_port": {
            "type": "integer",
            "minimum": 20000,
            "maximum": 29999
          },
          "guest_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "vm",
          "network",
          "protocol",
          "external_port",
          "guest_port",
          "allowed_sources"
        ],
        "additionalProperties": false
      },
      "SliceRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Network"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "vms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VM"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "publications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Publication"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "name",
          "networks",
          "vms"
        ],
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "required": [
          "id",
          "slice_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slice_id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "delete",
              "reconcile",
              "start",
              "stop"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "created": {
            "type": "number"
          },
          "updated": {
            "type": "number"
          }
        }
      },
      "Console": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "token",
          "expires_at",
          "url"
        ],
        "additionalProperties": false
      },
      "Probe": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "addresses",
              "ping",
              "neighbors"
            ],
            "default": "addresses"
          },
          "target": {
            "type": "string",
            "format": "ipv4"
          },
          "packet_bytes": {
            "type": "integer",
            "minimum": 16,
            "maximum": 1400
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "ProbeResult": {
        "type": "object",
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "stdout": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "returncode",
          "stdout"
        ],
        "additionalProperties": false
      },
      "Slice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/SliceRequest"
          },
          "plan": {
            "type": "object",
            "description": "Plan inmutable con id,svid,transit,MAC,VNC,gateway,disk_bytes,guest y nombres de NIC. Diagnostics proporciona PID, worker, qemu_name y disk_path reales."
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "DEPLOYING",
              "READY",
              "STOPPING",
              "STOPPED",
              "STARTING",
              "RECONCILING",
              "DELETING",
              "DELETED",
              "ERROR",
              "ERROR_CLEANUP",
              "FAILED_CLEANED"
            ]
          },
          "reserved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "virtual_size": {
            "type": "integer"
          },
          "created": {
            "type": "number"
          }
        }
      },
      "Generic": {
        "type": "object",
        "additionalProperties": true
      },
      "Guest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os"
        ],
        "properties": {
          "os": {
            "type": "string",
            "enum": [
              "ubuntu",
              "cirros"
            ]
          },
          "username": {
            "type": "string"
          },
          "password_hash": {
            "type": "string",
            "description": "SHA512 crypt para login VNC; requerido en Ubuntu."
          },
          "ssh_authorized_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Ubuntu requiere username,password_hash,ssh_authorized_keys; CirrOS usa las credenciales configuradas en el agente."
      }
    }
  }
}
